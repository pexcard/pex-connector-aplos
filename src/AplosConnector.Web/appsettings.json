{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.AspNetCore.HttpLogging": "Information",
            "System": "Warning",
            "Azure": "Warning"
        }
    },
    "AllowedHosts": "*",
    "TelemetryConfig": {
        "Enabled": true,
        "Resource": {
            "ApplicationName": "pex-connector-aplos",
            "ServiceName": "pex-connector-aplos-api",
            "DeploymentEnvironment": "sandbox",
            "DeploymentRegion": "azure",
            "DeploymentHostType": "local",
            "AdditionalAttributes": {
                "_sourceCategory": "/sandbox/marketplace/pex-connector-aplos",
                "_sourceName": "pex-connector-aplos"
            },
            "IncludeTelemetrySdk": true,
            "IncludeEnvironmentVariables": false
        },
        "Tracing": {
            "Enabled": true,
            "SamplingProbability": 1.0,
            "AspNetCore": {
                "Enabled": true,
                "ExcludedPaths": [
                    "/api/Health/Ping"
                ],
                "RecordException": true
            },
            "HttpClient": {
                "Enabled": true,
                "RecordException": true
            }
        },
        "Metrics": {
            "Enabled": true,
            "AddProcessInstrumentation": true,
            "AddRuntimeInstrumentation": true,
            "AddAspNetCoreInstrumentation": true,
            "AddHttpClientInstrumentation": true
        },
        "Logging": {
            "Enabled": true
        },
        "Exporter": {
            "Enabled": false,
            "Protocol": "HttpProtobuf",
            "BaseUrl": "REPLACE"
        }
    },
    "AppSettings": {
        "PexConnectorBaseURL": "https://oauth.pexcard.com",
        "PexApiClientId": "REPLACE",
        "PexApiClientSecret": "REPLACE",
        "AplosConnectorBaseURL": "REPLACE",
        "AplosApiClientId": "REPLACE",
        "AplosApiClientSecret": "REPLACE",
        "AplosApiBaseURL": "https://app.aplos.com/hermes/api/v1/",
        "AplosPartnerVerificationUrl": "https://aplos.com/aws/accounting/pex",
        "PEXAPIBaseURL": "https://coreapi.pexcard.com",
        "PEXAPITimeout": 100,
        "StorageAccountName": "REPLACE",
        "DataProtectionApplicationName": "AplosConnector",
        "DataProtectionBlobContainer": "data-protection",
        "DataProtectionBlobName": "keys.xml",
        "DataProtectionKeyIdentifier": "REPLACE",

        "AzureServiceBusUrl": "REPLACE",
        "AzureServiceBusTopicName": "REPLACE",
        "EmailMaxCount": "REPLACE",
        "EmailPeriodicityDays": "REPLACE",

        "SyncTransactionsIntervalDays": 60
    }
}
